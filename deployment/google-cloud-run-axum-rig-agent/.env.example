# Copy to `.env` for local runs. In Docker / Cloud Run pass these as runtime
# secrets/env vars instead of baking them into the image.
DEEPSEEK_API_KEY=sk-...

# At least 16 characters; signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to false for local plain-HTTP development (otherwise the browser refuses
# the Secure cookie).
COOKIE_SECURE=false

# User store (email + argon2 password hashes). Without USERS_BUCKET the app uses
# a local file.
# USERS_FILE=users.json

# Emails seeded on first run; each gets a temporary password printed to the log.
# AUTH_EMAILS=liguanglai@gmail.com,lglstock@gmail.com

# Optional. Shut down after this many seconds without a request (default 1800,
# 0 disables). Health probes are ignored.
# IDLE_TIMEOUT_SECS=1800
